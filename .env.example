# Manager Agent

DEFAULT_ACCOUNT_ID=1

# Paper trading guardrails
# TRADING_ENABLED=true enables Manager_Agent risk checks to pass in PAPER mode.
# LIVE trading still requires TRADING_MODE=LIVE and ALLOW_LIVE_TRADING=true explicitly.
TRADING_ENABLED=true
TRADING_MODE=PAPER
ALLOW_LIVE_TRADING=false

# Web Control Center
# Generate a strong random value and enter it manually in the private web UI.
# Never put this token in Trading_Frontend VITE_* variables or commit a real value.
WEB_CONTROL_OPERATOR_TOKEN=replace_with_random_operator_token
# Keep execution disabled until the planning/confirmation UI and downstream agents are verified.
WEB_CONTROL_ALLOW_EXECUTION=false
# Live web execution requires all three switches:
# TRADING_MODE=LIVE, ALLOW_LIVE_TRADING=true, WEB_CONTROL_ALLOW_LIVE_EXECUTION=true
WEB_CONTROL_ALLOW_LIVE_EXECUTION=false
WEB_CONTROL_CONFIRMATION_TTL_SECONDS=900
# Optional hard ceiling in account currency. Leave blank to rely on the TradePlan/Risk limits.
WEB_CONTROL_MAX_ORDER_NOTIONAL=

# Agent URLs
TECHNICAL_AGENT_URL=http://technical-agent:8002
FUNDAMENTAL_AGENT_URL=http://fundamental-agent:8001
SCANNER_AGENT_URL=http://scanner-agent:8003
DATABASE_AGENT_URL=http://database-agent:8004
AUTO_LEARNING_AGENT_URL=http://learning-agent:8005
RISK_AGENT_URL=http://risk-agent:8007
EXECUTION_AGENT_URL=http://execution-agent:8006
PORTFOLIO_AGENT_URL=http://portfolio-agent:8012
PROFIT_AGENT_URL=http://profit-agent:8011
PROFIT_AGENT_API_KEY=
PROFIT_MARKET_DATA_MAX_AGE_SECONDS=120

# Profit lifecycle rollout (PAPER/SIMULATOR only)
PROFIT_DECISION_EXECUTION_ENABLED=false
PROFIT_AUTO_EXIT_ALL_ENABLED=false

# API keys for service-to-service calls
DATABASE_AGENT_API_KEY=replace_me
EXECUTION_API_KEY=replace_me
PORTFOLIO_AGENT_API_KEY=replace_me

# Important: Manager_Agent must not connect to PostgreSQL directly.
# Do not set DATABASE_URL here. Only Database_Agent should own DATABASE_URL.

# Risk settings used as input defaults before external Risk_Agent approval
RISK_PER_TRADE=0.01
STOP_LOSS_PERCENTAGE=0.03
MAX_POSITION_PERCENTAGE=0.10
MAX_TOTAL_EXPOSURE=0.50
PER_REQUEST_RISK_BUDGET=0.05
MIN_POSITION_VALUE=500
